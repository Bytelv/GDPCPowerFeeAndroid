<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：卡片式分组（房间 / 提醒设置 / 图标说明）。
  颜色全部走语义化名字，深色模式由 values-night 自动接管。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ============ 房间 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="监控的房间"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentRoomText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="准备中…"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/reloadBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary_bg"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="更换房间（重新读取房间列表）"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/pickerGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="校区"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/campusSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="楼栋"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/buildingSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="房间（括号内为当前余额）"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/roomSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 提醒设置 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="提醒设置"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="提醒阈值（度）：低于此值就提醒"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/thresholdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如 20"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="后台查询间隔（15 分钟是 Android 的系统下限）"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/intervalSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/wifiOnlyCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/accent"
                android:text="仅在 WiFi 下查询（省流量：接口一次返回全校，约 940 KB）"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/notifyWarnCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="进入预警区也提醒（关掉则只提醒低电量）"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/notifyRecoveryCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="充值恢复后提醒一次"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/dynamicIconCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent"
                android:text="桌面图标随电量变色"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ============ 关于图标变色 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关于桌面图标变色"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="Android 没有官方的“动态改图标”接口，本应用靠切换四个桌面图标别名实现，个别第三方桌面会因此重排甚至移除图标（重新拖出来即可）。若不希望如此，可关掉这一项，改用桌面小组件——小组件同样按电量状态变色，且完全稳定。"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============ 保存 ============ -->
        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary_bg"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="保存并开始监控"
            android:textColor="@color/btn_primary_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="3dp"
            android:text="保存后请务必做两件事，否则可能收不到提醒：\n1) 允许本应用发送通知；\n2) 在系统设置里允许本应用自启动、并加入电池优化白名单（小米/华为/OPPO/vivo 尤其严格）。"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
